[Unit]
Description=Tasch — Distributed Task Scheduler
Documentation=https://github.com/deziss/tasch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tasch
Group=tasch
ExecStart=/usr/bin/tasch start --config /etc/tasch/config.yaml
ExecStop=/usr/bin/tasch stop --config /etc/tasch/config.yaml
Restart=on-failure
RestartSec=5s

# Must outlast the daemon's own drain (drain_timeout, default 60s) plus the stop command's
# margin, or systemd kills the master mid-drain with database writes still in flight.
TimeoutStopSec=120

LimitNOFILE=65535

# State and runtime directories, created and owned by systemd.
StateDirectory=tasch
StateDirectoryMode=0750

# Give the service its own cgroup subtree. Without this, the daemon cannot create per-job
# cgroups — cgroup v2 refuses to delegate controllers to the children of a cgroup that holds
# other processes — and every job runs with no CPU, memory, or process limit at all.
Delegate=cpu memory pids

# --- Hardening ---
#
# Note the inherent limit: a Tasch worker's job is to run arbitrary user commands as this
# service account, so anything that would confine the *job* also confines the scheduler. These
# settings therefore protect the host from the daemon. Per-job confinement is separate: CPU,
# memory and process limits come from the delegated cgroup above, and filesystem, PID and IPC
# isolation from `sandbox.mode` in the config. See SECURITY.md.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
# Namespaces are how `sandbox.mode` isolates a job, so they cannot be blocked outright — a
# worker under `RestrictNamespaces=yes` fails every job it was told to sandbox. This is the
# narrowest allowance that works: mnt, pid, ipc and uts build the sandbox, user is what lets an
# unprivileged worker build it at all, and net is only used by `sandbox.network: none`.
# Remove `user` if the worker runs as root, and `net` if you never set `network: none`.
RestrictNamespaces=mnt pid ipc uts user net
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

# PrivateDevices is left off and /dev access preserved so GPU device nodes remain visible to
# jobs. Narrow this with DeviceAllow if the node has no GPUs.
#
# ProtectHome=yes and ProtectSystem=strict apply to the daemon and are inherited by every job it
# runs, so a job cannot write outside StateDirectory even with `sandbox.mode: none`. That is a
# useful floor, not a substitute: it does not stop one job reading another's files, which is
# what the sandbox is for.

[Install]
WantedBy=multi-user.target
